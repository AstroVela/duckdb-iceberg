# name: test/sql/local/vortex/vortex_filters.test
# group: [vortex]

require-env ICEBERG_TEST_VORTEX 1

require avro

require parquet

require iceberg

require vortex

foreach format vortex parquet

statement ok
COPY (
    SELECT * FROM (VALUES (1, 'NaN'::DOUBLE), (2, 1.0::DOUBLE), (3, NULL::DOUBLE)) v(id, x)
) TO '__TEST_DIR__/iceberg_filter_{format}' (FORMAT iceberg, DATA_FORMAT {format});

# The filter column is absent from the projection, including count(*).
query I
SELECT id FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE isnan(x) ORDER BY id;
----
1

query I
SELECT count(*) FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE isnan(x);
----
1

query I
SELECT id FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE NOT isnan(x) ORDER BY id;
----
2

query I
SELECT id FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE isfinite(x) ORDER BY id;
----
2

query I
SELECT id FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE isnan(x) OR x IS NULL ORDER BY id;
----
1
3

query I
SELECT id FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE coalesce(isnan(x), true) ORDER BY id;
----
1
3

query I
SELECT count(*) FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE id >= 2 AND isnan(x);
----
0

query I
SELECT id FROM iceberg_scan('__TEST_DIR__/iceberg_filter_{format}') WHERE isnan(x) OR id = 2 ORDER BY id;
----
1
2

endloop
